{
  "name": "lean-blackboard",
  "displayName": "Lean Blackboard",
  "description": "Shows Lean 4 hypotheses and goals with rendered math notation.",
  "version": "0.3.0",
  "private": true,
  "publisher": "amaseroaragon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amaseroaragon/lean-blackboard"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "leanprover.lean4"
  ],
  "activationEvents": [
    "onLanguage:lean4"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "leanBlackboard.dumpGoals",
        "title": "Dump Goals",
        "category": "Lean Blackboard"
      },
      {
        "command": "leanBlackboard.showLean",
        "title": "Show Lean Syntax",
        "category": "Lean Blackboard",
        "icon": "$(code)"
      },
      {
        "command": "leanBlackboard.showMath",
        "title": "Show Math Notation",
        "category": "Lean Blackboard",
        "icon": "$(symbol-operator)"
      },
      {
        "command": "leanBlackboard.toggleNotation",
        "title": "Toggle Math / Lean Notation",
        "category": "Lean Blackboard"
      },
      {
        "command": "leanBlackboard.copyGoalState",
        "title": "Copy Goal State as LaTeX",
        "category": "Lean Blackboard",
        "icon": "$(copy)"
      },
      {
        "command": "leanBlackboard.pinGoalState",
        "title": "Pin Goal State",
        "category": "Lean Blackboard",
        "icon": "$(pin)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leanBlackboard",
          "title": "Lean Blackboard",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "leanBlackboard": [
        {
          "type": "webview",
          "id": "leanBlackboard.goals",
          "name": "Goals"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "leanBlackboard.showLean",
          "when": "view == leanBlackboard.goals && leanBlackboard.notation != lean",
          "group": "navigation"
        },
        {
          "command": "leanBlackboard.showMath",
          "when": "view == leanBlackboard.goals && leanBlackboard.notation == lean",
          "group": "navigation"
        },
        {
          "command": "leanBlackboard.copyGoalState",
          "when": "view == leanBlackboard.goals",
          "group": "navigation@2"
        },
        {
          "command": "leanBlackboard.pinGoalState",
          "when": "view == leanBlackboard.goals",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "leanBlackboard.showLean",
          "when": "leanBlackboard.notation != lean"
        },
        {
          "command": "leanBlackboard.showMath",
          "when": "leanBlackboard.notation == lean"
        }
      ]
    },
    "configuration": {
      "title": "Lean Blackboard",
      "properties": {
        "leanBlackboard.customRules": {
          "type": "object",
          "default": {},
          "markdownDescription": "Extra or overriding LaTeX rules. Templates use `#1`, `#2`… for operands; `{#1}` drops Lean-only parentheses. Example: `{\"functions\": {\"Real.sinh\": \"\\\\sinh #1\"}, \"symbols\": {\"G\": \"\\\\mathcal{G}\"}, \"infix\": {\"→\": \"#1 \\\\Rightarrow #2\"}}`. Only operators the parser already knows can be re-rendered.",
          "properties": {
            "symbols": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Identifier → LaTeX (no placeholders)."
            },
            "functions": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Fully qualified function → template with #1, #2…"
            },
            "infix": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Infix operator → template with #1 and #2."
            },
            "prefix": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Prefix operator → template with #1."
            },
            "postfix": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Postfix operator → template with #1."
            },
            "binders": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Binder (∀ ∃ ∃! ∑ ∏) → LaTeX command."
            }
          },
          "additionalProperties": false
        },
        "leanBlackboard.macros": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "KaTeX macros (equivalent to `\\newcommand`), usable in custom rules. Example: `{\"\\\\R\": \"\\\\mathbb{R}\", \"\\\\abs\": \"\\\\left|#1\\\\right|\"}`."
        },
        "leanBlackboard.mode": {
          "type": "string",
          "enum": [
            "auto",
            "fast"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Precise mode (LaTeX from the real expressions) when the file imports the companion package `LeanBlackboard`; fast mode otherwise.",
            "Always use the fast, text-based conversion."
          ],
          "description": "Conversion mode."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node licenses.mjs && vsce package --no-dependencies -o ../../lean-blackboard.vsix",
    "build:test": "node esbuild.integration.mjs",
    "test:integration": "node esbuild.integration.mjs && node dist-test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "~3.1.0",
    "@vscode/vsce": "~4.1.0"
  },
  "dependencies": {
    "@lean-blackboard/core": "*"
  }
}
