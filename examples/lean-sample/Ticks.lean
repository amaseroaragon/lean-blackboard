import LeanBlackboard

/-! A proof followed by many slow commands that emit messages: while they elaborate, the file's
diagnostics change continuously (as in a large file with warnings). Used by the integration tests. -/

theorem ticks_demo (a b : Nat) (h : a = b) : a + 0 = b * 1 := by
  simp only [Nat.add_zero, Nat.mul_one]
  exact h

